
name: Build JARVIS Windows EXE

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    runs-on: windows-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.11"

      - name: Extract JARVIS ZIP
        shell: pwsh
        run: |
          Expand-Archive `
            -LiteralPath "JARVIS-OptiPlex-7060-GitHub-Actions-Windows-EXE.zip" `
            -DestinationPath "source" `
            -Force

      - name: Check project files
        shell: pwsh
        run: |
          Get-ChildItem "source" -Recurse -Depth 2
          if (!(Test-Path "source/pc_companion/jarvis_pc_server.py")) {
            throw "PC companion source file not found inside ZIP."
          }
          if (!(Test-Path "source/pc_companion/requirements.txt")) {
            throw "requirements.txt not found inside ZIP."
          }

      - name: Install dependencies
        working-directory: source/pc_companion
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          pip install pyinstaller

      - name: Build EXE
        working-directory: source/pc_companion
        run: |
          pyinstaller --noconfirm --clean --onefile --name JARVIS-PC jarvis_pc_server.py

      - name: Upload EXE
        uses: actions/upload-artifact@v4
        with:
          name: JARVIS-Windows-EXE
          path: source/pc_companion/dist/JARVIS-PC.exe
          if-no-files-found: error
